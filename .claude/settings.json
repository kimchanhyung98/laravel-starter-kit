{
  "respectGitignore": true,
  "cleanupPeriodDays": 21,
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.prod*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.crt)",
      "Read(**/*.cer)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.tfvars)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.ssh/*)",
      "Read(**/.aws/*)",
      "Read(**/credentials.json)",
      "Edit(../**)",
      "Write(../**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/scope-guard.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-browser@agent-browser": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "asana@claude-plugins-official": false,
    "atlassian@claude-plugins-official": false,
    "circleback@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": true,
    "firebase@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "gitlab@claude-plugins-official": false,
